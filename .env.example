# Copy this file to .env and replace the example values. Never commit real secrets.
PI_API_KEY=replace_with_your_Pi_server_key
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=pitill
PORT=3000
APP_URL=http://localhost:3000
# Optional comma-separated browser origins, e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=
